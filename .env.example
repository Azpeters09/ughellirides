# UghelliRides production environment
PORT=8787
ADMIN_TOKEN=generate-a-long-random-string-here

# ─── Supabase (PostgreSQL) — set BOTH to use cloud storage ───
# When set, the backend uses Supabase; when empty, it falls back to local SQLite.
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # service_role key (server-side only, never expose)

# ─── SQLite fallback (only used when Supabase env vars are empty) ───
# DB_PATH=/var/data/ughellirides.db
